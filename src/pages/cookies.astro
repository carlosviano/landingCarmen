---
// /cookies: qué guarda la web en el navegador. El texto vive en
// src/config/legal/cookies.ts.
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import { LEGALES_PUBLICADOS } from "@/config/site";
import PaginaLegal from "@/components/legal/PaginaLegal.astro";
import { COOKIES } from "@/config/legal/cookies";
---

<Layout titulo={COOKIES.titulo}>
  {/* Mientras no se enlacen (LEGALES_PUBLICADOS), fuera de Google: aún
      llevan datos entre corchetes. */}
  <Fragment slot="head">
    {!LEGALES_PUBLICADOS && <meta name="robots" content="noindex" />}
  </Fragment>
  <Header />
  <PaginaLegal texto={COOKIES} />
  <Footer />
</Layout>
