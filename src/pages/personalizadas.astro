---
// /personalizadas — los diseños de Carmela que se encargan a medida.
//
// Misma estructura que /eventos (hero a sangre con la franja de los tres
// pasos, una lista y el formulario de cierre), porque es el mismo tipo de
// encargo: se habla, se propone y se presupuesta. Lo que separa un servicio
// del otro está en el paso 3 de la franja: aquí "La recoges" en el obrador,
// allí "Lo monto" en el sitio. Y el enlace bajo la rejilla lo dice en voz
// alta para quien dude.
//
// En vez de historias en zigzag, un escaparate de diseños: no se viene a leer
// qué se hizo, se viene a elegir qué pedir. Cada diseño es una tarjeta
// horizontal (components/TarjetaEscaparate) con todo a la vista: para qué
// ocasiones, qué es, sus fotos en miniatura y "Pedir esta tarta", que baja al
// formulario con él marcado. Sin JS ese botón es un enlace normal
// (?diseno=<slug>#solicitud).
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import Ondas from "@/components/Ondas.astro";
import Hero from "@/components/Hero.astro";
import TarjetaEscaparate from "@/components/TarjetaEscaparate.astro";
import SolicitudEspecial from "@/components/especiales/SolicitudEspecial.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { ESPECIALES } from "@/config/personalizadas";
import { SERVICIOS } from "@/config/site";
import { fotoDe } from "@/lib/fotos";

const E = ESPECIALES;

// Como en /eventos: si el nombre no existe, `fotoDe` revienta el build.
const fotoCabecera = fotoDe(E.fotoCabecera)!;

// Las fotos de cada diseño, ya resueltas: la de la tarjeta primero y detrás
// las de `galeria`.
const disenos = E.disenos.map((diseno) => ({
  diseno,
  fotos: [
    ...(diseno.archivo
      ? [{ archivo: diseno.archivo, alt: diseno.alt, enfoque: diseno.enfoque }]
      : []),
    ...diseno.galeria,
  ].map((foto) => ({ ...foto, src: fotoDe(foto.archivo)! })),
}));

const conDiseno = (slug: string) => `?diseno=${slug}#solicitud`;

// Con un número par de diseños, la tarjeta de "¿No sabes cuál?" quedaría
// sola en la última fila de escritorio: ahí ocupa las dos columnas y cierra
// la rejilla. Con impar ya cae en el hueco que queda.
const proponerAncha = E.disenos.length % 2 === 0;
---

<Layout titulo={E.tituloPagina} descripcion={E.entradillaPagina}>
  <Header />

  <main>
    {/* El hero de /eventos, con sus mismas piezas: foto a sangre bajo un
        velo que oscurece la parte baja, "Inicio" arriba, el texto abajo
        (mt-auto) y la franja rust con los pasos. Las proporciones son las
        del marco común (components/Hero.astro). */}
    <Hero claseBanda="isolate overflow-hidden bg-black" claseFranja="bg-rust">
      <Image
        src={fotoCabecera}
        alt={E.altCabecera}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        style={`object-position: ${E.enfoqueCabecera}`}
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-black/15 via-black/35 to-black/85"
        aria-hidden="true"
      ></div>

      <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-6 pt-10 pb-12 md:pb-14">
        <a
          href="/"
          class="mb-16 inline-flex items-center gap-2 self-start border-b border-linen/40 pb-1 accion text-xs text-linen/85 transition-colors hover:border-linen/70 hover:text-white"
        >
          <Icon
            name="lucide:arrow-left"
            class="size-4 shrink-0"
            aria-hidden="true"
          />
          Inicio
        </a>

        <p class="mt-auto antetitulo text-sand">{E.etiquetaPagina}</p>
        <h1 class="mt-5 max-w-3xl titular text-4xl leading-[1.05] text-balance text-white sm:text-5xl lg:text-[4.5rem]">
          {E.tituloPagina}
        </h1>

        <div class="mt-7 flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
          <p class="max-w-[33rem] text-base leading-relaxed text-white/85 sm:text-lg">
            {E.entradillaPagina}
          </p>
          <a
            href="#solicitud"
            class="self-start rounded-full bg-sand px-8 py-4 text-center accion text-xs text-rust shadow-lg shadow-black/25 transition-colors hover:bg-white md:self-auto"
          >
            {E.ctaCabecera}
          </a>
        </div>
      </div>

      <Ondas slot="fondo-franja" id="especiales-pasos" class="text-linen/12" />
      <ol slot="franja" class="grid w-full gap-5 md:grid-cols-3 md:gap-8">
        {E.pasos.map((paso, i) => (
          <li class="flex items-center gap-5">
            <span class="w-6 shrink-0 text-center titulo text-4xl leading-none text-sand">
              {i + 1}
            </span>
            <span>
              <span class="block antetitulo text-linen">{paso.titulo}</span>
              <span class="mt-1.5 block text-sm text-linen/80">
                {paso.detalle}
              </span>
            </span>
          </li>
        ))}
      </ol>
    </Hero>

    <section class="pt-12 pb-2 md:pt-16 md:pb-4">
      <div class="mx-auto w-full max-w-7xl px-6">
        <p class="antetitulo text-rust">{E.etiquetaDisenos}</p>
        <h2 class="mt-4 titulo text-4xl leading-[1.08] text-balance sm:text-5xl">
          {E.tituloDisenos}
        </h2>
      </div>

      {/* Una columna hasta lg (en móvil la tarjeta sigue siendo horizontal,
          con la foto estrecha) y dos desde lg. */}
      <div class="mx-auto mt-8 grid w-full max-w-7xl gap-4 px-6 md:mt-11 lg:grid-cols-2 lg:gap-7">
        {disenos.map(({ diseno, fotos }) => (
          <TarjetaEscaparate
            id={diseno.slug}
            titulo={diseno.nombre}
            etiqueta={diseno.ocasiones}
            descripcion={diseno.descripcion}
            fotos={fotos}
            precio={E.precio}
            textoFoto={E.tarjeta.foto}
            accion={{
              texto: E.tarjeta.pedir,
              href: conDiseno(diseno.slug),
              "data-elige": diseno.slug,
            }}
          />
        ))}

        {/* La salida para quien no sabe cuál: del tamaño de las otras, en
            rust y con las ondas de la franja. Baja al formulario con "Que me
            proponga Carmela" marcado. El botón es de mentira (un span): la
            tarjeta entera ya es el enlace. A todo el ancho (`proponerAncha`)
            es una banda: el texto a la izquierda y el botón a la derecha. */}
        <a
          href={conDiseno(E.proponer.slug)}
          data-elige={E.proponer.slug}
          class:list={[
            "group relative isolate flex flex-col justify-between gap-8 overflow-hidden rounded-3xl bg-rust p-6 text-linen sm:p-8 lg:px-10 lg:py-9",
            proponerAncha ? "lg:col-span-2 lg:gap-5" : "lg:min-h-80",
          ]}
        >
          <Ondas id="proponer" class="-z-10 text-linen/12" />
          <span class="leyenda text-sand">{E.proponer.leyenda}</span>
          <span
            class:list={[
              "flex flex-col items-start",
              proponerAncha &&
                "lg:flex-row lg:items-end lg:justify-between lg:gap-12",
            ]}
          >
            <span class="max-w-md titulo text-[1.75rem] leading-[1.1] text-balance sm:text-4xl">
              {E.proponer.titulo}
            </span>
            <span
              class:list={[
                "mt-5 inline-flex min-h-11 shrink-0 items-center rounded-full bg-sand px-5.5 accion text-[10px] text-rust transition-colors group-hover:bg-white sm:mt-6 sm:text-[11px]",
                proponerAncha && "lg:mt-0",
              ]}
            >
              {E.proponer.boton}
            </span>
          </span>
        </a>
      </div>

      {/* La frontera con Eventos, con el estilo de "Hay más proyectos en
          Instagram": no compite con las tarjetas. */}
      <div class="mt-12 flex justify-center px-6 md:mt-14">
        <a
          href={SERVICIOS.eventos.ruta}
          class="inline-flex max-w-xs items-center gap-2 border-b border-taupe/40 pb-1 text-center accion text-xs leading-relaxed text-black transition-colors hover:border-black sm:max-w-none"
        >
          {E.aEventos}
          <Icon
            name="lucide:arrow-right"
            class="size-4 shrink-0"
            aria-hidden="true"
          />
        </a>
      </div>
    </section>

    <SolicitudEspecial />
  </main>

  <Footer />
</Layout>

<script>
  import { alPulsarEnlace, elegirDiseno } from "@/lib/elegirDiseno";

  // "Pedir esta tarta" y la tarjeta de "que me proponga" bajan al formulario
  // sin recargar (ver elegirDiseno).
  document
    .querySelectorAll<HTMLAnchorElement>("a[data-elige]")
    .forEach((tarjeta) => {
      alPulsarEnlace(tarjeta, () => elegirDiseno(tarjeta.dataset.elige!));
    });
</script>
