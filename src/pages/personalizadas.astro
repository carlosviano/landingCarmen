---
// /personalizadas — los diseños de Carmela que se encargan a medida.
//
// Misma estructura que /eventos (hero a sangre con la franja de los tres
// pasos, una lista y el formulario de cierre), porque es el mismo tipo de
// encargo: se habla, se propone y se presupuesta. Lo que separa un servicio
// del otro está en el paso 3 de la franja: aquí "La recoges" en el obrador,
// allí "Lo monto" en el sitio. Y el enlace bajo la rejilla lo dice en voz
// alta para quien dude.
//
// En vez de historias en zigzag, una rejilla de diseños con el marco de la
// carta: no se viene a leer qué se hizo, se viene a elegir qué pedir. Cada
// tarjeta abre la ficha de su diseño (components/especiales/FichaDiseno),
// con más fotos y "La quiero", que baja al formulario con él marcado. Sin JS
// la tarjeta enlaza directamente al formulario (?diseno=<slug>#solicitud).
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import Ondas from "@/components/Ondas.astro";
import Hero from "@/components/Hero.astro";
import TarjetaDiseno from "@/components/especiales/TarjetaDiseno.astro";
import FichaDiseno from "@/components/especiales/FichaDiseno.astro";
import SolicitudEspecial from "@/components/especiales/SolicitudEspecial.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { ESPECIALES, SERVICIOS } from "@/config/site";
import { fotoDe } from "@/lib/fotos";

const E = ESPECIALES;

// Como en /eventos: si el nombre no existe, `fotoDe` revienta el build.
const fotoCabecera = fotoDe(E.fotoCabecera)!;

const disenos = E.disenos.map((diseno, i) => ({
  diseno,
  numero: i + 1,
  foto: fotoDe(diseno.archivo),
}));

const conDiseno = (slug: string) => `?diseno=${slug}#solicitud`;
---

<Layout titulo={E.tituloPagina} descripcion={E.entradillaPagina}>
  <Header />

  <main>
    {
      /* El hero de /eventos, con sus mismas piezas: foto a sangre bajo un
        velo que oscurece la parte baja, "Inicio" arriba, el texto abajo
        (mt-auto) y la franja rust con los pasos. Las proporciones son las
        del marco común (components/Hero.astro). */
    }
    <Hero claseBanda="isolate overflow-hidden bg-black" claseFranja="bg-rust">
      <Image
        src={fotoCabecera}
        alt={E.altCabecera}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        style={`object-position: ${E.enfoqueCabecera}`}
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-black/15 via-black/35 to-black/85"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-6 pt-10 pb-12 md:pb-14">
        <a
          href="/"
          class="mb-16 inline-flex items-center gap-2 self-start border-b border-linen/40 pb-1 accion text-xs text-linen/85 transition-colors hover:border-linen/70 hover:text-white"
        >
          <Icon name="lucide:arrow-left" class="size-4 shrink-0" aria-hidden="true" />
          Inicio
        </a>

        <p class="mt-auto antetitulo text-sand">{E.etiquetaPagina}</p>
        <h1
          class="mt-5 max-w-3xl titular text-4xl leading-[1.05] text-balance text-white sm:text-5xl lg:text-[4.5rem]"
        >
          {E.tituloPagina}
        </h1>

        <div class="mt-7 flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
          <p class="max-w-[33rem] text-base leading-relaxed text-white/85 sm:text-lg">
            {E.entradillaPagina}
          </p>
          <a
            href="#solicitud"
            class="self-start rounded-full bg-sand px-8 py-4 text-center accion text-xs text-rust shadow-lg shadow-black/25 transition-colors hover:bg-white md:self-auto"
          >
            {E.ctaCabecera}
          </a>
        </div>
      </div>

      <Ondas slot="fondo-franja" id="especiales-pasos" class="text-linen/12" />
      <ol slot="franja" class="grid w-full gap-5 md:grid-cols-3 md:gap-8">
        {
          E.pasos.map((paso, i) => (
            <li class="flex items-center gap-5">
              <span class="w-6 shrink-0 text-center titulo text-4xl leading-none text-sand">{i + 1}</span>
              <span>
                <span class="block antetitulo text-linen">{paso.titulo}</span>
                <span class="mt-1.5 block text-sm text-linen/80">{paso.detalle}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </Hero>

    <section class="pt-12 pb-2 md:pt-16 md:pb-4">
      <div
        class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
      >
        <div>
          <p class="antetitulo text-rust">{E.etiquetaDisenos}</p>
          <h2 class="mt-4 titulo text-4xl leading-[1.08] text-balance sm:text-5xl">
            {E.tituloDisenos}
          </h2>
        </div>
        <p class="max-w-md text-[0.9375rem] leading-relaxed text-black/70">
          {E.textoDisenos.antes}<a
            href={SERVICIOS.carta.ruta}
            class="text-rust underline underline-offset-2 hover:text-black">{E.textoDisenos.enlace}</a
          >{E.textoDisenos.despues}
        </p>
      </div>

      <div
        class="mx-auto mt-8 grid w-full max-w-7xl grid-cols-2 gap-x-3.5 gap-y-8 px-6 md:mt-11 lg:grid-cols-4 lg:gap-x-7"
      >
        {
          disenos.map(({ diseno, numero, foto }) => (
            <TarjetaDiseno
              href={conDiseno(diseno.slug)}
              data-abre-ficha={diseno.slug}
              aria-haspopup="dialog"
              numero={numero}
              nombre={diseno.nombre}
              ocasiones={diseno.ocasiones}
              precio={E.precio}
            >
              {foto ? (
                <Image
                  src={foto}
                  alt={diseno.alt}
                  widths={[200, 320, 440, 640]}
                  sizes="(min-width: 1024px) 19rem, 45vw"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
                  style={diseno.enfoque && `object-position: ${diseno.enfoque}`}
                />
              ) : (
                /* El "foto pendiente" de la carta, MARCADO a propósito: dice
                  qué falta en vez de rellenar con una foto que no es. */
                <div class="grid h-full w-full place-items-center">
                  <span class="leyenda text-rust/70">Foto pendiente</span>
                </div>
              )}
            </TarjetaDiseno>
          ))
        }

        {
          /* La salida para quien no sabe cuál: misma tarjeta, en rust y con
            las ondas de la franja. Baja al formulario con "Que me proponga
            Carmela" marcado, sin ficha: no hay nada más que enseñar. El
            botón es de mentira (un span): la tarjeta entera ya es el
            enlace. */
        }
        <TarjetaDiseno
          href={conDiseno(E.proponer.slug)}
          data-elige={E.proponer.slug}
          nombre={E.proponer.nombre}
          ocasiones={E.proponer.ocasiones}
          precio={E.precio}
          claseMarco="bg-rust"
        >
          <Ondas id="proponer" class="text-linen/12" />
          <div class="relative flex h-full flex-col p-4.5 sm:p-7">
            <span class="leyenda text-sand">{E.proponer.leyenda}</span>
            <span class="mt-auto titulo text-[1.375rem] leading-[1.1] text-balance text-linen sm:text-3xl">
              {E.proponer.titulo}
            </span>
            <span
              class="mt-3.5 inline-flex min-h-11 items-center self-start rounded-full bg-sand px-4 accion text-[10px] text-rust transition-colors group-hover:bg-white sm:mt-5 sm:px-5 sm:text-[11px]"
            >
              {E.proponer.boton}
            </span>
          </div>
        </TarjetaDiseno>
      </div>

      {
        /* La frontera con Eventos, con el estilo de "Hay más proyectos en
          Instagram": no compite con las tarjetas. */
      }
      <div class="mt-12 flex justify-center px-6 md:mt-14">
        <a
          href={SERVICIOS.eventos.ruta}
          class="inline-flex max-w-xs items-center gap-2 border-b border-taupe/40 pb-1 text-center accion text-xs leading-relaxed text-black transition-colors hover:border-black sm:max-w-none"
        >
          {E.aEventos}
          <Icon name="lucide:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
        </a>
      </div>
    </section>

    {E.disenos.map((diseno) => <FichaDiseno diseno={diseno} />)}

    <SolicitudEspecial />
  </main>

  <Footer />
</Layout>

<script>
  import { alPulsarEnlace, elegirDiseno } from "@/lib/elegirDiseno";

  // Las tarjetas, con JS: la de un diseño abre su ficha y la de "que me
  // proponga" baja al formulario sin recargar (ver elegirDiseno).
  document.querySelectorAll<HTMLAnchorElement>("a[data-abre-ficha]").forEach((tarjeta) => {
    const ficha = document.querySelector<HTMLDialogElement>(
      `dialog[data-ficha][data-diseno="${CSS.escape(tarjeta.dataset.abreFicha!)}"]`,
    );
    if (ficha) alPulsarEnlace(tarjeta, () => ficha.showModal());
  });

  document.querySelectorAll<HTMLAnchorElement>("a[data-elige]").forEach((tarjeta) => {
    alPulsarEnlace(tarjeta, () => elegirDiseno(tarjeta.dataset.elige!));
  });
</script>
