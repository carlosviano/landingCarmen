---
// Pantalla de "próximamente": la variante "Escena" del diseño, con la cocinera
// montando el toldo. Texto a la izquierda e ilustración a la derecha en
// escritorio; apilado en móvil, con la fecha por encima del pliegue.
//
// Esta página existe siempre, pero solo se ve en lugar de la web cuando
// src/middleware.ts la pone en todas las rutas (en producción, mientras
// PROXIMAMENTE.enProduccion siga en true). En staging y en las previews vive
// en /proximamente, para poder enseñársela a la clienta sin publicar nada.
//
// Sin cabecera, pie, menú ni redes a propósito: es una pantalla de espera, no
// una página del sitio, y cualquier enlace llevaría a la web a medias.
import Layout from "@/layouts/Layout.astro";
import EscenaToldo from "@/components/proximamente/EscenaToldo.astro";
import { PROXIMAMENTE } from "@/config/proximamente";
import { modoProximamente } from "@/lib/proximamente";

const { titular, entradilla, apertura, pie } = PROXIMAMENTE;

// Tipografía: la de toda la web (src/styles/global.css). The Seasons en el
// titular, la marca y la fecha; Karla en el resto. Las dos las carga el Layout.

// Cuando NO es la portada (staging, previews, local), que no la indexe nadie:
// ahí es una página suelta de revisión, no el sitio.
const esPortada = modoProximamente();
---

<Layout
  titulo="Próximamente"
  bienvenida={false}
  descripcion={`Alta pastelería por encargo en Málaga. ${apertura.antetitulo} ${apertura.texto}.`}
>
  <Fragment slot="head">
    {!esPortada && <meta name="robots" content="noindex" />}
  </Fragment>

  <main
    class="relative flex min-h-svh flex-col items-center px-4 pt-14 pb-16 lg:justify-center lg:px-6 lg:py-18"
  >
    <div
      class="grid w-full max-w-310 grid-cols-1 items-center gap-7 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14"
    >
      <div
        class="flex flex-col items-center gap-4.5 text-center lg:items-start lg:gap-5.5 lg:text-left"
      >
        <p class="titulo text-xl text-rust">
          Estimada Carmela
        </p>
        <h1
          class="titular text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.02] text-balance"
        >
          {titular.antes}
          {titular.destacado && <em class="text-rust not-italic">{titular.destacado}</em>}
        </h1>
        <p
          class="max-w-[32em] text-[clamp(1.0625rem,1.5vw,1.1875rem)] leading-[1.55] text-pretty text-black/80"
        >
          {entradilla}
        </p>
        <p
          class="mt-1.5 flex w-full max-w-75 flex-col items-center gap-1.5 border-t border-taupe pt-4.5 lg:w-auto lg:max-w-none lg:min-w-65 lg:items-start"
        >
          <span
            class="antetitulo text-black/65"
          >
            {apertura.antetitulo}
          </span>
          <time
            class="titulo text-[clamp(1.625rem,2.6vw,2.125rem)] whitespace-nowrap text-rust"
            datetime={apertura.iso}
          >
            {apertura.texto}
          </time>
        </p>
      </div>

      <div class="w-full max-w-130 justify-self-center lg:max-w-none">
        <EscenaToldo />
      </div>
    </div>

    <p
      class="absolute inset-x-0 bottom-6 px-6 text-center dato text-xs text-black/65"
    >
      {pie}
    </p>
  </main>
</Layout>
