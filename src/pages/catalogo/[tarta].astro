---
// /catalogo/<id> — la ficha de una tarta.
//
// Ruta estática: se genera una página por tarta a partir de CATALOGO, así que
// añadir una tarta en src/config/catalogo.ts crea su ficha sola. Cada una
// tiene su URL, y eso es el punto: se comparte por WhatsApp, se guarda en marcadores y
// la indexa un buscador. Un panel o un modal no dan ninguna de las tres.
//
// UNA SOLA PLANTILLA PARA TODAS. Lo que cambia de una tarta a otra —la foto,
// adónde apunta cada línea, qué capas tiene— son datos de `catalogo.ts`, no
// código. Una tarta montada de otra manera lleva otros números, no otra
// página.
//
// La página son estos bloques y en este orden:
//
//   1. La tarta y el pedido. Con recorte anotado (ver `estaAnotada`), la
//      tarta va en el centro con las etiquetas de "qué lleva" a la izquierda y
//      una línea de cada una a su capa (FichaAnotada); el pedido, a la
//      derecha (Pedido). Sin recorte, foto normal (o FotoPendiente) y la lista
//      sin líneas (ListaComponentes). Encima del pedido, los alérgenos
//      (Alergenos). En escritorio llena una pantalla.
//   2. La tira con las otras tartas (OtrasTartas), que es cómo se pasa de una
//      a otra.
//
// Un solo CTA en toda la página, el de WhatsApp del pedido.
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import BotonVolver from "@/components/BotonVolver.astro";
import FotoPendiente from "@/components/FotoPendiente.astro";
import Alergenos from "@/components/catalogo/Alergenos.astro";
import FichaAnotada from "@/components/catalogo/FichaAnotada.astro";
import ListaComponentes from "@/components/catalogo/ListaComponentes.astro";
import OtrasTartas from "@/components/catalogo/OtrasTartas.astro";
import Pedido from "@/components/catalogo/Pedido.astro";
import Foto from "@/components/Foto.astro";
import TextoRevelado from "@/components/TextoRevelado.astro";
import { CATALOGO, type Tarta } from "@/config/catalogo";
import { conFotos, estaAnotada, otrasTartas } from "@/lib/tartas";

export function getStaticPaths() {
  return CATALOGO.tartas.map((tarta, i) => ({
    params: { tarta: tarta.id },
    props: { tarta, indice: i },
  }));
}

interface Props {
  tarta: Tarta;
  indice: number;
}

const { tarta, indice } = Astro.props;

const otras = otrasTartas(CATALOGO.tartas, indice).map(conFotos);

const anotada = estaAnotada(tarta);
const fotos = conFotos(tarta);
// Con líneas, el recorte; sin ellas, la foto con fondo (`null` = pendiente).
const recorte = anotada ? fotos.recorte : null;
const foto = anotada ? null : fotos.foto;
---

<Layout titulo={tarta.nombre} descripcion={tarta.descripcion}>
  <Header />

  {/* `overflow-x-clip`: en móvil la tarta anotada se pinta más ancha que la
      pantalla y sangra por la derecha. `clip` y no `hidden` para no crear un
      contenedor de scroll ni romper nada `sticky`. */}
  <main class="overflow-x-clip">
    {/* --- Volver y la tarta: UNA pantalla en escritorio ---

        `min-h` y no `h`: si el contenido no cabe, la sección crece y no se
        recorta nada. Forzar la altura exacta obligaría a recortar o a
        encoger la letra. El 4.25rem es el alto real de la cabecera sticky (68 px,
        medido; `py-4` + el logo). Si la cabecera cambia de alto, hay que
        cambiarlo aquí.

        El botón de volver va DENTRO: fuera, el bloque medía una pantalla pero
        empezaba debajo de él, y se salía siempre por abajo lo que
        mide el botón.

        En portátiles bajos (768–900 px) no cabe con el espaciado normal, así
        que la variante `bajo:` (global.css) aprieta rellenos y huecos. */}
    <div class="lg:flex lg:min-h-[calc(100svh-4.25rem)] lg:flex-col">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="pt-3 sm:pt-8 bajo:pt-5">
          <BotonVolver href="/catalogo">Volver a la carta</BotonVolver>
        </div>
      </div>

      <div class="lg:flex lg:flex-1 lg:items-center">
        <div class="mx-auto w-full max-w-7xl px-6">
          <div
            class="ficha py-6 lg:py-8 bajo:py-3"
            data-anotada={anotada ? "" : undefined}
          >
            {/* El nombre centrado encima de la tarta, en rust (8.5:1 sobre
                linen). Encima y nunca detrás de la foto: ahí el contraste
                dependería de qué píxel de la tarta le tocara debajo. */}
            <h1 class="ficha-titulo text-center titular text-4xl leading-[1.12] text-balance text-rust sm:text-5xl lg:text-[3.1rem]">
              <TextoRevelado texto={tarta.nombre} />
            </h1>

            <div class="ficha-foto">
              {anotada ? (
                <FichaAnotada tarta={tarta} recorte={recorte!} />
              ) : (
                <div class="mx-auto w-full max-w-[26rem] overflow-hidden rounded-3xl bg-taupe/15 shadow-lg shadow-black/5 ring-1 ring-taupe/25 lg:max-w-[27rem]">
                  {foto ? (
                    <Foto
                      src={foto}
                      alt={tarta.alt}
                      widths={[420, 640, 900]}
                      sizes="(min-width: 1024px) 27rem, (min-width: 640px) 26rem, 90vw"
                      loading="eager"
                      decoding="async"
                      class="aspect-[4/5] h-full w-full object-cover object-center"
                    />
                  ) : (
                    <FotoPendiente class="aspect-[4/5] w-full" />
                  )}
                </div>
              )}
            </div>

            <div class="ficha-info flex flex-col gap-6 bajo:gap-4">
              {
                /* Sin recorte anotado, "qué lleva" vuelve a su sitio de
                  siempre: una lista con viñetas en esta columna. */
                !anotada && <ListaComponentes componentes={tarta.componentes} />
              }

              <Alergenos alergenos={tarta.alergenos} />

              <Pedido tarta={tarta} />
            </div>
          </div>
        </div>
      </div>
    </div>

    <OtrasTartas otras={otras} />
  </main>

  <Footer />
</Layout>

<style>
  /*
    La rejilla de la ficha. Lo de dentro de la tarta anotada (etiquetas,
    líneas, zoom en móvil) es de FichaAnotada.

      - móvil y tableta: el nombre, la tarta y el pedido, apilados.
      - escritorio (lg): tres columnas —etiquetas, tarta, texto y pedido— con
        el nombre centrado encima de la tarta. La primera es la columna de
        etiquetas de FichaAnotada: su `--lab` cuenta con estos 190 px + 3rem.
  */

  .ficha {
    display: flex;
    flex-direction: column;
  }

  /* Huecos cortos a propósito: el lienzo ya trae aire transparente encima y
     debajo de la tarta (está centrada en alto, ver `Tarta.recorte`), y con
     márgenes más grandes la tarta quedaba aislada del nombre y del pedido. */
  .ficha-foto {
    margin-top: 1.25rem;
  }

  .ficha-info {
    margin-top: 1rem;
  }

  @media (min-width: 64rem) {
    .ficha {
      display: grid;
      grid-template-columns: 190px minmax(0, 1fr) 340px;
      grid-template-areas:
        ". titulo info"
        ". foto   info";
      column-gap: 3rem;
      row-gap: 1.875rem;
    }

    /* Sin recorte no hay etiquetas que colgar a la izquierda: dos columnas,
       foto y texto, como la ficha de antes. */
    .ficha:not([data-anotada]) {
      grid-template-columns: minmax(0, 1fr) 400px;
      grid-template-areas:
        "titulo info"
        "foto   info";
      column-gap: 3.5rem;
    }

    .ficha-titulo {
      grid-area: titulo;
      align-self: end;
    }

    .ficha-foto {
      grid-area: foto;
      align-self: start;
      margin-top: 0;
    }

    .ficha-info {
      grid-area: info;
      align-self: center;
      margin-top: 0;
    }

    /* En pantallas bajas la columna del pedido se ensancha: con el texto en
       menos líneas pierde altura, que es lo que falta. La tarta estrecha un
       poco, pero es apaisada y le sobra alto. */
    @media (max-height: 56.25rem) {
      .ficha {
        grid-template-columns: 190px minmax(0, 1fr) 380px;
      }
    }
  }
</style>
