---
// /eventos — la lista de montajes ya servidos, con su URL propia.
//
// Es a donde lleva "Eventos" del menú y el único enlace del escaparate de la
// portada. Misma relación que /catalogo con Catalogo.astro: la portada es un
// ESCAPARATE (dos montajes, para dar ganas) y esto es el ÍNDICE (todos,
// leídos uno a uno). Por eso lleva su propia cabecera —foto a sangre y una
// franja rust con los tres pasos del encargo— en vez de la cabecera apretada de
// /catalogo: aquí no se llega a comparar filas de una carta, se llega a leer
// historias, y cada una quiere su sitio.
//
// Cierra con el formulario de solicitud (SolicitudEvento.astro), que es a
// donde baja el botón de la cabecera.
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import Ondas from "@/components/Ondas.astro";
import TarjetaEvento from "@/components/eventos/TarjetaEvento.astro";
import SolicitudEvento from "@/components/eventos/SolicitudEvento.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { EVENTOS, SOCIAL } from "@/config/site";
import { fotoDe } from "@/lib/fotos";

// Un montaje siempre tiene foto (ver la nota de `Montaje.archivo`), así que
// el `!` es seguro: sólo la habría sin ella si `archivo` no existiera en
// src/assets/images, y entonces `fotoDe` ya habría reventado el build antes.
const conFoto = EVENTOS.montajes.map((montaje, i) => ({
  montaje,
  foto: fotoDe(montaje.archivo)!,
  // Zigzag: impares con la foto a la izquierda, pares a la derecha (la
  // primera, en i=0, abre con el texto a la izquierda).
  fotoIzquierda: i % 2 === 1,
}));

// La foto de la cabecera, resuelta como las de las tarjetas: si el nombre no
// existe, `fotoDe` revienta el build.
const fotoCabecera = fotoDe(EVENTOS.fotoCabecera)!;

// El enlace de cierre de la lista va al perfil, no a un post: busca el mismo
// SOCIAL que usan cabecera y pie, para no mantener la URL dos veces.
const instagram = SOCIAL.find((red) => red.label === "Instagram")!;
---

<Layout titulo={EVENTOS.tituloPagina} descripcion={EVENTOS.entradillaPagina}>
  <Header />

  <main>
    {
      /* Cabecera a sangre: la foto ocupa la banda entera y el texto va abajo,
        sobre un velo que oscurece sólo la parte baja. La de antes era una
        franja rust lisa con el titular, y a la clienta le faltaba algo: aquí
        lo que falta lo pone la foto, que es lo que se viene a ver. */
    }
    <section
      class="relative isolate flex min-h-[36rem] items-end overflow-hidden bg-black md:min-h-[44rem]"
    >
      <Image
        src={fotoCabecera}
        alt={EVENTOS.altCabecera}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_38%]"
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-black/15 via-black/35 to-black/85"
        aria-hidden="true"
      >
      </div>

      <div
        class="mx-auto flex w-full max-w-7xl flex-col px-6 pt-10 pb-12 md:pb-14"
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 self-start border-b border-linen/40 pb-1 accion text-xs text-linen/85 transition-colors hover:border-linen/70 hover:text-white"
        >
          <Icon name="lucide:arrow-left" class="size-4 shrink-0" aria-hidden="true" />
          Inicio
        </a>

        <p class="mt-40 antetitulo text-sand md:mt-52">
          {EVENTOS.etiquetaPagina}
        </p>
        <h1
          class="mt-5 max-w-3xl titular text-4xl leading-[1.05] text-balance text-white sm:text-5xl lg:text-[4.5rem]"
        >
          {EVENTOS.tituloPagina}
        </h1>

        <div
          class="mt-7 flex flex-col gap-7 md:flex-row md:items-center md:justify-between"
        >
          <p class="max-w-[33rem] text-base leading-relaxed text-white/85 sm:text-lg">
            {EVENTOS.entradillaPagina}
          </p>
          <a
            href="#solicitud"
            class="inline-flex items-center gap-2 self-start rounded-full bg-sand px-8 py-4 accion text-xs text-rust shadow-lg shadow-black/25 transition-colors hover:bg-black hover:text-white md:self-auto"
          >
            {EVENTOS.ctaCabecera}
            <Icon name="lucide:arrow-down" class="size-4 shrink-0" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-rust">
      <Ondas id="eventos-pasos" class="text-linen/12" />
      <ol
        class="relative mx-auto grid w-full max-w-7xl gap-8 px-6 py-10 md:grid-cols-3"
      >
        {
          EVENTOS.pasos.map((paso, i) => (
            <li class="flex items-baseline gap-5">
              <span class="titulo text-4xl leading-none text-sand">{i + 1}</span>
              <span>
                <span class="block antetitulo text-linen">{paso.titulo}</span>
                <span class="mt-1.5 block text-sm text-linen/80">
                  {paso.detalle}
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="pt-12 pb-2 md:pt-16 md:pb-4">
      <div class="mx-auto w-full max-w-7xl px-6">
        <p class="antetitulo text-rust">{EVENTOS.etiquetaMontajes}</p>
        <h2
          class="mt-4 titulo text-4xl leading-[1.08] text-balance sm:text-5xl"
        >
          {EVENTOS.tituloMontajes}
        </h2>
      </div>

      <div
        class="mx-auto mt-10 flex w-full max-w-7xl flex-col gap-10 px-6 md:mt-12 lg:gap-14"
      >
        {
          conFoto.map(({ montaje, foto, fotoIzquierda }) => (
            <TarjetaEvento
              montaje={montaje}
              foto={foto}
              fotoIzquierda={fotoIzquierda}
            />
          ))
        }
      </div>

      <div class="mt-14 flex justify-center px-6">
        <a
          href={instagram.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-b border-taupe/40 pb-1 text-center accion text-xs text-black transition-colors hover:border-black"
        >
          <Icon name={instagram.icon} class="size-4 shrink-0" aria-hidden="true" />
          {EVENTOS.masMontajes}
          <Icon name="lucide:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
        </a>
      </div>
    </section>

    <SolicitudEvento />
  </main>

  <Footer />
</Layout>
