---
// /eventos — la lista de montajes ya servidos, con su URL propia.
//
// Es a donde lleva "Eventos" del menú y el único enlace del escaparate de la
// portada. Misma relación que /catalogo con Catalogo.astro: la portada es un
// ESCAPARATE (un montaje, para dar ganas) y esto es el ÍNDICE (todos,
// leídos uno a uno). Por eso lleva su propio hero —foto a sangre y una
// franja rust con los tres pasos del encargo— en vez de la cabecera apretada de
// /catalogo: aquí no se llega a comparar filas de una carta, se llega a leer
// historias, y cada una quiere su sitio.
//
// Cierra con el formulario de solicitud (SolicitudEvento.astro), que es a
// donde baja el botón de la cabecera.
import Layout from "@/layouts/Layout.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";
import Ondas from "@/components/Ondas.astro";
import Hero from "@/components/Hero.astro";
import TarjetaEvento from "@/components/eventos/TarjetaEvento.astro";
import SolicitudEvento from "@/components/eventos/SolicitudEvento.astro";
import Foto from "@/components/Foto.astro";
import TextoRevelado from "@/components/TextoRevelado.astro";
import { Icon } from "astro-icon/components";
import { EVENTOS } from "@/config/eventos";
import { SOCIAL } from "@/config/site";
import { fotoDe } from "@/lib/fotos";
import { ANCHOS_GRANDES, anchoCubierto } from "@/lib/imagenes";

// Un montaje siempre tiene foto (ver la nota de `Montaje.archivo`), así que
// el `!` es seguro: sólo la habría sin ella si `archivo` no existiera en
// src/assets/images, y entonces `fotoDe` ya habría reventado el build antes.
const conFoto = EVENTOS.montajes.map((montaje, i) => ({
  montaje,
  foto: fotoDe(montaje.archivo)!,
  // Zigzag: impares con la foto a la izquierda, pares a la derecha (la
  // primera, en i=0, abre con el texto a la izquierda).
  fotoIzquierda: i % 2 === 1,
}));

// La foto de la cabecera, resuelta como las de las tarjetas: si el nombre no
// existe, `fotoDe` revienta el build.
const fotoCabecera = fotoDe(EVENTOS.fotoCabecera)!;

// A sangre con object-cover: en el móvil la banda es más alta que ancha y
// una foto apaisada (o menos vertical que la pantalla) se pinta más ancha
// que el 100vw. El alto es el máximo que puede tener la banda: la pantalla
// menos la cabecera y la franja más baja (lib/imagenes.ts).
const sizesCabecera = anchoCubierto(
  fotoCabecera,
  "100vw",
  "(100vh - 8.5625rem)",
);

// El enlace de cierre de la lista va al perfil, no a un post: busca el mismo
// SOCIAL que usan cabecera y pie, para no mantener la URL dos veces.
const instagram = SOCIAL.find((red) => red.label === "Instagram")!;
---

<Layout titulo={EVENTOS.tituloPagina} descripcion={EVENTOS.entradillaPagina}>
  <Header />

  <main>
    {/* Cabecera a sangre: la foto ocupa la banda entera y el texto va abajo,
        sobre un velo que oscurece sólo la parte baja. La de antes era una
        franja rust lisa con el titular, y a la clienta le faltaba algo: aquí
        lo que falta lo pone la foto, que es lo que se viene a ver.

        Las proporciones son las del marco común (components/Hero.astro), las
        mismas que el hero de la portada: banda y franja llenan la pantalla,
        en el móvil y en escritorio.

        El bloque de texto se estira contra la banda (flex-1) y el antetítulo
        se va abajo con mt-auto: así "Inicio" queda arriba y el titular abajo
        midan lo que midan banda y pantalla. El mb-16 de "Inicio" es el hueco
        mínimo entre los dos si la pantalla es baja. */}
    <Hero claseBanda="isolate overflow-hidden bg-black" claseFranja="bg-rust">
      <Foto
        src={fotoCabecera}
        alt={EVENTOS.altCabecera}
        widths={ANCHOS_GRANDES}
        sizes={sizesCabecera}
        loading="eager"
        fetchpriority="high"
        data-revelar="zoom"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_38%]"
      />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-b from-black/15 via-black/35 to-black/85"
        aria-hidden="true"
      ></div>

      <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-6 pt-10 pb-12 md:pb-14">
        <a
          href="/"
          data-revelar
          class="mb-16 inline-flex items-center gap-2 self-start border-b border-linen/40 pb-1 accion text-xs text-linen/85 transition-colors hover:border-linen/70 hover:text-white"
        >
          <Icon
            name="lucide:arrow-left"
            class="size-4 shrink-0"
            aria-hidden="true"
          />
          Inicio
        </a>

        <p data-revelar class="mt-auto antetitulo text-sand">
          {EVENTOS.etiquetaPagina}
        </p>
        <h1 class="mt-5 max-w-3xl titular text-4xl leading-[1.05] text-balance text-white sm:text-5xl lg:text-[4.5rem]">
          <TextoRevelado texto={EVENTOS.tituloPagina} />
        </h1>

        <div class="mt-7 flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
          <p
            data-revelar
            class="max-w-[33rem] text-base leading-relaxed text-white/85 sm:text-lg"
          >
            {EVENTOS.entradillaPagina}
          </p>
          <a
            href="#solicitud"
            data-revelar
            class="self-start rounded-full bg-sand px-8 py-4 text-center accion text-xs text-rust shadow-lg shadow-black/25 transition-colors hover:bg-white md:self-auto"
          >
            {EVENTOS.ctaCabecera}
          </a>
        </div>
      </div>

      <Ondas slot="fondo-franja" id="eventos-pasos" class="text-linen/12" />
      <ol slot="franja" class="grid w-full gap-5 md:grid-cols-3 md:gap-8">
        {EVENTOS.pasos.map((paso, i) => (
          <li data-revelar class="flex items-center gap-5">
            <span class="w-6 shrink-0 text-center titulo text-4xl leading-none text-sand">
              {i + 1}
            </span>
            <span>
              <span class="block antetitulo text-linen">{paso.titulo}</span>
              <span class="mt-1.5 block text-sm text-linen/80">
                {paso.detalle}
              </span>
            </span>
          </li>
        ))}
      </ol>
    </Hero>

    <section class="pt-12 pb-2 md:pt-16 md:pb-4">
      <div class="mx-auto w-full max-w-7xl px-6">
        <p data-revelar class="antetitulo text-rust">
          {EVENTOS.etiquetaMontajes}
        </p>
        <h2 class="mt-4 titulo text-4xl leading-[1.08] text-balance sm:text-5xl">
          <TextoRevelado texto={EVENTOS.tituloMontajes} />
        </h2>
      </div>

      <div class="mx-auto mt-10 flex w-full max-w-7xl flex-col gap-10 px-6 md:mt-12 lg:gap-14">
        {conFoto.map(({ montaje, foto, fotoIzquierda }) => (
          <TarjetaEvento
            montaje={montaje}
            foto={foto}
            fotoIzquierda={fotoIzquierda}
          />
        ))}
      </div>

      <div class="mt-14 flex justify-center px-6">
        <a
          href={instagram.href}
          target="_blank"
          rel="noopener noreferrer"
          data-revelar
          class="inline-flex items-center gap-2 border-b border-taupe/40 pb-1 text-center accion text-xs text-black transition-colors hover:border-black"
        >
          <Icon
            name={instagram.icon}
            class="size-4 shrink-0"
            aria-hidden="true"
          />
          {EVENTOS.masMontajes}
          <Icon
            name="lucide:arrow-right"
            class="size-4 shrink-0"
            aria-hidden="true"
          />
        </a>
      </div>
    </section>

    <SolicitudEvento />
  </main>

  <Footer />
</Layout>
