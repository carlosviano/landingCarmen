---
import Layout from "../layouts/Layout.astro";
import { SEO_PORTADA } from "../config/portada";
import Header from "../sections/Header.astro";
import Hero from "../sections/Hero.astro";
import Eventos from "../sections/Eventos.astro";
import Catalogo from "../sections/Catalogo.astro";
import SobreMi from "../sections/SobreMi.astro";
import Galeria from "../sections/Galeria.astro";
import Contacto from "../sections/Contacto.astro";
import Footer from "../sections/Footer.astro";
---

<Layout titulo={SEO_PORTADA.titulo} descripcion={SEO_PORTADA.descripcion}>
  <Header />
  <Hero />
  <Catalogo />
  <Eventos />
  <SobreMi />
  <Galeria />
  <Contacto />
  <Footer />
</Layout>
