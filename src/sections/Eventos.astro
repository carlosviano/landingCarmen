---
// Sección "eventos" de la portada: solo montajes. Antetítulo, titular y
// entradilla, y debajo UNA foto de mesa a todo el ancho con un único enlace, a
// /eventos, que es donde está la lista completa. Qué foto sale se decide en
// `ESCAPARATE_EVENTOS` (src/config/site.ts).
//
// Las tartas no van aquí: tienen su díptico justo encima (Catalogo.astro). El
// escaparate anterior mezclaba las dos cosas —un botón de tartas
// personalizadas sobre una mesa dulce y uno de eventos sobre una pavlova— y
// quien llegaba no sabía qué era cada cosa.
//
// El id de la sección sale de `SERVICIOS.eventos.ancla`, para quien enlace
// a #eventos. El menú y el botón del hero, en cambio, van directos a /eventos.
//
// La foto va a todo el ancho y cambia de proporción con la pantalla: 4:5 en
// móvil (como el resto de fotos sueltas de la web), 2:1 en tablet y 3:1 en
// escritorio. El 3:1 es lo que hace que la sección entera quepa en los ~800px
// útiles de un portátil de 13": unos 410px de foto más el texto. Si algún día
// el texto crece mucho, la sección se sale de la pantalla en vez de
// recortarse —mismo trato que SobreMi, no hay overflow-hidden escondiendo el
// problema.
//
// Ojo: NO va centrada en vertical en una pantalla entera. El texto empieza
// arriba, a un `lg:pt-12` fijo, para que lo que hay encima (el díptico) y esto
// se lean seguidos y no con un hueco que crece con la pantalla.
import { Image } from "astro:assets";
import { ESCAPARATE_EVENTOS, EVENTOS, SERVICIOS } from "@/config/site";
import { fotoDe } from "@/lib/fotos";

// `fotoDe` revienta el build si el nombre no existe (ver src/lib/fotos.ts), y
// `archivo` es obligatorio, así que el `!` es seguro.
const foto = fotoDe(ESCAPARATE_EVENTOS.archivo)!;
---

<section id={SERVICIOS.eventos.ancla} class="scroll-mt-20">
  <div class="mx-auto w-full max-w-7xl px-6 py-16 md:py-20 lg:pt-12 lg:pb-10">
    <p class="antetitulo text-rust">
      {EVENTOS.etiqueta}
    </p>
    <h2
      class="mt-5 max-w-2xl titulo text-4xl leading-[1.05] text-balance sm:text-5xl"
    >
      {EVENTOS.titulo}
    </h2>
    <p
      class="mt-6 max-w-[34rem] text-base leading-relaxed text-black/80 sm:text-lg"
    >
      {EVENTOS.entradilla}
    </p>

    <div class="mt-12 lg:mt-8">
      <a
        href={SERVICIOS.eventos.ruta}
        class="group relative block aspect-[4/5] overflow-hidden rounded-3xl bg-taupe/15 shadow-md shadow-black/5 ring-1 ring-taupe/40 md:aspect-[2/1] lg:aspect-[3/1]"
      >
        <Image
          src={foto}
          alt={ESCAPARATE_EVENTOS.alt}
          widths={[420, 640, 860, 1080, 1280]}
          sizes="(min-width: 1280px) 1232px, calc(100vw - 3rem)"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
          style={`object-position:${ESCAPARATE_EVENTOS.enfoque}`}
        />
        <span
          class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-rust px-6 py-3 text-center accion text-xs whitespace-nowrap text-linen shadow-lg shadow-black/25 transition-colors group-hover:bg-rust-hondo"
        >
          {ESCAPARATE_EVENTOS.cta}
        </span>
      </a>
      <p class="mt-4 dato text-[11px] text-black/50">
        {ESCAPARATE_EVENTOS.pie}
      </p>
    </div>
  </div>
</section>
