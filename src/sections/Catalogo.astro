---
// Sección de tartas de la portada: el escaparate. Un díptico a sangre con las
// dos formas de encargar una tarta —la carta a un lado, las personalizadas al
// otro—, cada mitad con su foto y su único botón. Qué sale en cada mitad se
// decide en `ESCAPARATE` (src/config/portada.ts).
//
// Es la variante PURISTA del diseño: sin titular visible ni entradilla. Cada
// mitad lleva lo justo para elegir: una leyenda que dice en qué se distingue
// de la otra ("precio cerrado" frente a "a medida") y el botón con el nombre
// del servicio, el mismo que en el menú. El titular sigue existiendo para el
// esquema del documento y para un lector de pantalla, en `sr-only`, igual que
// en Galería y en Contacto.
//
// Lo que esta sección NO hace, y es deliberado: no es el catálogo. No enseña
// las tartas ni deja comparar; para eso están /catalogo y /personalizadas.
// Esto es una puerta a cada una.
//
// Cada mitad tiene su ancla (#carta y #personalizadas, sacadas de
// `SERVICIOS`), aunque los botones del hero ya van a las páginas. Por eso el `scroll-mt-20` va en las mitades y no
// en la sección: la cabecera es sticky y sin él taparía la parte de arriba.
import Foto from "@/components/Foto.astro";
import { ESCAPARATE } from "@/config/portada";
import { fotoDe } from "@/lib/fotos";
import { ANCHOS_GRANDES, anchoCubierto } from "@/lib/imagenes";

// Las fotos se nombran en config/portada.ts y las resuelve `fotoDe`, que revienta el
// build si el nombre no existe (ver src/lib/fotos.ts). El `!` es seguro:
// `fotoDe` sólo devuelve null si se le pasa null, y `archivo` es obligatorio.
//
// Con `recorteAbajo`, la foto sale ya recortada del build: se le da el ancho
// del original y el alto que queda, y `fit="cover"` con `position="top"` le
// quita la franja de abajo. Las versiones del srcset heredan ese recorte.
const entradas = ESCAPARATE.entradas.map((entrada) => {
  const original = fotoDe(entrada.archivo)!;
  const recorte = entrada.recorteAbajo
    ? {
        width: original.width,
        height: Math.round(original.height * (1 - entrada.recorteAbajo)),
      }
    : null;
  // La proporción que se pinta, ya recortada: es la que cuenta para el sizes.
  const pintada = recorte ? { ...original, ...recorte } : original;
  return { ...entrada, foto: original, recorte, sizes: sizesDe(pintada) };
});

// Cada mitad ocupa media pantalla en escritorio y toda en móvil, pero las
// cajas son casi cuadradas en escritorio (43.75rem de alto) y una foto
// apaisada se pinta, con object-cover, bastante más ancha que su 50vw. El
// sizes lleva ese ancho, con los altos de la caja de abajo (lib/imagenes.ts).
function sizesDe(foto: ImageMetadata) {
  return [
    `(min-width: 1024px) ${anchoCubierto(foto, "50vw", "43.75rem")}`,
    `(min-width: 768px) ${anchoCubierto(foto, "50vw", "34rem")}`,
    `(min-width: 640px) ${anchoCubierto(foto, "100vw", "20rem")}`,
    anchoCubierto(foto, "100vw", "18rem"),
  ].join(", ");
}

// El velo del botón: un óvalo oscuro centrado, sólo detrás de él. Un contorno
// claro a pelo desaparece sobre el merengue o el azúcar blanco de las fotos.
// Así el contraste queda garantizado sin tapar la textura, que es lo que se ha
// venido a ver.
const VELO =
  "radial-gradient(ellipse 46% 34% at 50% 50%, rgba(48,18,9,0.52) 0%, rgba(48,18,9,0.22) 55%, rgba(48,18,9,0) 78%)";
---

{/* A sangre: sin el `max-w-7xl px-6` del resto de las secciones. El díptico
  vive de llegar a los dos bordes de la pantalla. */}
<section>
  <h2 class="sr-only">{ESCAPARATE.titulo}</h2>

  {/* Sin `gap`: las dos mitades se tocan y se leen como un solo bloque a
    sangre. Apiladas en móvil, la carta va primero: es el encargo más
    directo, con precio y tamaño cerrados. */}
  <div class="grid grid-cols-1 md:grid-cols-2">
    {entradas.map(
      ({ servicio, foto, recorte, sizes, alt, enfoque, leyenda }) => (
        <div
          id={servicio.ancla}
          class="relative h-72 scroll-mt-20 overflow-hidden bg-taupe sm:h-80 md:h-[34rem] lg:h-[43.75rem]"
        >
          <Foto
            src={foto}
            alt={alt}
            {...(recorte && { ...recorte, fit: "cover", position: "top" })}
            widths={ANCHOS_GRANDES}
            sizes={sizes}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
            style={`object-position:${enfoque}`}
          />

          <div
            aria-hidden="true"
            class="absolute inset-0"
            style={`background:${VELO}`}
          />

          {/* `py-4` con `text-xs` deja el botón en unos 48px de alto, por
            encima del mínimo de 44 para el pulgar. */}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
            <p class="leyenda text-linen">{leyenda}</p>
            <a
              href={servicio.ruta}
              class="rounded-full border-[1.5px] border-linen/90 bg-rust/70 px-8 py-4 text-center accion text-xs text-linen backdrop-blur-[2px] transition-colors duration-300 hover:bg-rust sm:px-10"
            >
              {servicio.nombre}
            </a>
          </div>
        </div>
      ),
    )}
  </div>
</section>
