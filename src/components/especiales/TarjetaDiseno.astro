---
// Un diseño en la rejilla de /personalizadas.
//
// MISMO MARCO que la tarjeta de la carta (catalogo/TarjetaTarta.astro): 4:5,
// rounded-3xl, número y nombre en `titulo`, filete y una fila de datos. Que se
// lean como piezas que se eligen, de la misma familia que la carta. Lo que
// cambia es el contenido: a la izquierda para qué ocasiones suele pedirse y a
// la derecha "a presupuesto" en vez de un precio cerrado.
//
// Lo de dentro del marco va por el slot, porque no siempre es una foto: la
// última tarjeta de la rejilla ("¿No sabes cuál?") es un fondo rust con
// ondas, y un diseño sin foto lleva el "foto pendiente" de la carta.
//
// Como en la carta, la TARJETA ENTERA es el enlace y dentro no hay nada más
// interactivo. El enlace baja al formulario con el diseño ya marcado
// (?diseno=<slug>#solicitud): es lo que vale sin JS. Con JS la página lo
// cambia por otra cosa (abrir la ficha, bajar sin recargar) y se lo dice
// con los `data-` que entran por aquí y van tal cual al <a>.
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string;
  /** El 01, 02... de la rejilla. Sin él, una raya: la tarjeta de proponer no es un diseño. */
  numero?: number;
  nombre: string;
  ocasiones: string;
  precio: string;
  /** Fondo del marco mientras carga la foto, o el de la tarjeta si no hay foto. */
  claseMarco?: string;
}

const { href, numero, nombre, ocasiones, precio, claseMarco = "bg-taupe/15", ...resto } =
  Astro.props;
---

<a href={href} class="group block" {...resto}>
  <div class:list={["relative aspect-[4/5] overflow-hidden rounded-3xl", claseMarco]}>
    <slot />
  </div>

  {
    /* Número y nombre en la misma línea, como en la carta: el número es
      orientación visual, así que va pequeño, apagado y con aria-hidden. */
  }
  <div class="mt-4.5 flex items-baseline gap-2.5">
    <span class="text-[10px] tracking-[0.2em] text-black/40 tabular-nums" aria-hidden="true">
      {numero === undefined ? "—" : String(numero).padStart(2, "0")}
    </span>
    <h3 class="titulo text-xl leading-snug transition-colors group-hover:text-rust">
      {nombre}
    </h3>
  </div>

  {
    /* En móvil, con dos columnas, las ocasiones y el precio no caben en una
      línea: se apilan. Desde sm, a los dos extremos como en la carta. */
  }
  <div
    class="mt-3.5 flex flex-col gap-1 border-t border-taupe/50 pt-2.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3"
  >
    <span class="text-xs text-black/60">{ocasiones}</span>
    <span class="text-sm font-medium whitespace-nowrap text-rust">{precio}</span>
  </div>
</a>
