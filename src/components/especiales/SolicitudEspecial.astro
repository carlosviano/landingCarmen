---
// El formulario de solicitud del final de /personalizadas.
//
// Hermano de eventos/SolicitudEvento.astro: el mismo marco
// (MarcoSolicitud.astro), los mismos controles, la misma validación y el
// mismo envío. Cambian los campos: hay "Diseño", la fecha es la de RECOGIDA
// (sólo de lunes a viernes, que es cuando abre el obrador) y no hay lugar,
// porque una tarta especial se recoge y no se monta.
//
// El diseño es obligatorio ("Que me proponga Carmela" es la salida de quien
// no sabe cuál). Llega marcado desde la página: con JS lo marca
// src/lib/elegirDiseno.ts sin recargar; sin JS, o al recargar, el script de
// abajo lo lee de la URL (?diseno=<slug>#solicitud).
import Calendario from "@/components/formulario/Calendario.astro";
import Campo from "@/components/formulario/Campo.astro";
import Desplegable from "@/components/formulario/Desplegable.astro";
import FotosInspiracion from "@/components/formulario/FotosInspiracion.astro";
import MarcoSolicitud from "@/components/formulario/MarcoSolicitud.astro";
import {
  AREA,
  CAMPO,
  OPCION_OCULTA,
  PASTILLA,
} from "@/components/formulario/estilos";
import { ESPECIALES } from "@/config/personalizadas";
import { whatsappCon } from "@/config/site";
import { mensajeEspecial, OPCIONES_DISENO } from "@/lib/solicitud";

const S = ESPECIALES.solicitud;
const PILDORA = `${PASTILLA} flex min-h-11 items-center px-4 bajo:min-h-10`;
---

<MarcoSolicitud
  tipo="especial"
  textos={S}
  whatsapp={whatsappCon(mensajeEspecial())}
>
  <Campo
    nombre="diseno"
    etiqueta="Diseño"
    obligatorio
    grupo
    class="sm:col-span-2"
  >
    <div class="flex flex-wrap gap-2">
      {OPCIONES_DISENO.map((opcion) => (
        <label class="relative cursor-pointer">
          <input
            type="radio"
            name="diseno"
            value={opcion.valor}
            class={OPCION_OCULTA}
          />
          <span class={PILDORA}>{opcion.nombre}</span>
        </label>
      ))}
    </div>
  </Campo>

  <Campo
    nombre="ocasion"
    etiqueta="Ocasión"
    obligatorio
    grupo
    class="sm:col-span-2"
  >
    <div class="flex flex-wrap gap-2">
      {S.ocasiones.map((ocasion) => (
        <label class="relative cursor-pointer">
          <input
            type="radio"
            name="ocasion"
            value={ocasion}
            class={OPCION_OCULTA}
          />
          <span class={PILDORA}>{ocasion}</span>
        </label>
      ))}
    </div>
  </Campo>

  {/* `relative` aquí y no en la fila: el panel del calendario se abre
      con el ancho de este campo (en móvil, la fila entera). */}
  <Campo
    nombre="fecha"
    etiqueta="Fecha de recogida"
    obligatorio
    class="relative"
  >
    <Calendario
      id="solicitud-fecha"
      nombre="fecha"
      etiquetaId="fecha-etiqueta"
      titulo="Elegir el día de recogida"
      clasePanel="inset-x-0 sm:right-auto sm:w-80"
    />
  </Campo>

  <Campo nombre="personas" etiqueta="Personas" obligatorio>
    <Desplegable
      id="solicitud-personas"
      nombre="personas"
      etiquetaId="personas-etiqueta"
      opciones={S.personas}
      placeholder="Elige un rango"
    />
  </Campo>

  <Campo
    nombre="idea"
    etiqueta="Tu idea"
    para="solicitud-idea"
    class="sm:col-span-2"
  >
    <textarea
      id="solicitud-idea"
      name="idea"
      rows="4"
      placeholder={S.placeholderIdea}
      class={AREA}
    ></textarea>
  </Campo>

  <Campo nombre="fotos" etiqueta="Inspiración" class="sm:col-span-2">
    <FotosInspiracion
      nombre="fotos"
      etiquetaId="fotos-etiqueta"
      fotos={S.fotos}
      ayuda={S.ayudaFotos}
    />
  </Campo>

  <div class="border-t border-taupe/45 sm:col-span-2"></div>

  <Campo nombre="nombre" etiqueta="Nombre" para="solicitud-nombre" obligatorio>
    <input
      id="solicitud-nombre"
      type="text"
      name="nombre"
      autocomplete="name"
      placeholder="Tu nombre"
      class={CAMPO}
    />
  </Campo>

  <Campo
    nombre="telefono"
    etiqueta="Teléfono"
    para="solicitud-telefono"
    obligatorio
  >
    <input
      id="solicitud-telefono"
      type="tel"
      name="telefono"
      autocomplete="tel"
      placeholder="+34 600 000 000"
      class={CAMPO}
    />
  </Campo>

  <Campo
    nombre="email"
    etiqueta="Email"
    para="solicitud-email"
    obligatorio
    class="sm:col-span-2"
  >
    <input
      id="solicitud-email"
      type="email"
      name="email"
      autocomplete="email"
      placeholder="tu@correo.com"
      class={CAMPO}
    />
  </Campo>
</MarcoSolicitud>

<script>
  import { ESPECIALES } from "@/config/personalizadas";
  import { esLaborable } from "@/lib/pedido";
  import { montarSolicitud } from "@/lib/formularioSolicitud";
  import {
    mensajeEspecial,
    primeraFechaEspecial,
    validarEspecial,
  } from "@/lib/solicitud";

  document
    .querySelectorAll<HTMLFormElement>('[data-solicitud="especial"]')
    .forEach((form) => {
      // El diseño que trae el enlace de la tarjeta. Antes de montar, para que
      // el WhatsApp salga ya con él. Un slug que no esté en la lista no marca
      // nada: el selector no encuentra su radio.
      const diseno = new URLSearchParams(location.search).get("diseno");
      if (diseno) {
        const radio = form.querySelector<HTMLInputElement>(
          `input[name="diseno"][value="${CSS.escape(diseno)}"]`,
        );
        if (radio) radio.checked = true;
      }

      montarSolicitud(form, {
        validar: validarEspecial,
        mensaje: (texto) =>
          mensajeEspecial({
            diseno: texto("diseno"),
            ocasion: texto("ocasion"),
            personas: texto("personas"),
            fecha: texto("fecha"),
          }),
        calendario: { primera: primeraFechaEspecial, elegible: esLaborable },
        envio: ESPECIALES.solicitud.envio,
        enviado:
          "Recibido. Te escribo en cuanto lo lea con una propuesta para tu tarta.",
      });

      // `montarSolicitud` rehace el WhatsApp con cada cambio; el diseño marcado
      // aquí no ha disparado ninguno.
      form.dispatchEvent(new Event("change"));
    });
</script>
