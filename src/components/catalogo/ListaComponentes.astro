---
// "Qué lleva" como lista con viñetas: la de las fichas sin recorte anotado
// (ver `estaAnotada`). Con recorte, la lista va colgada de la foto, en
// FichaAnotada.
import type { ComponenteTarta } from "@/config/catalogo";

interface Props {
  componentes: ComponenteTarta[];
}

const { componentes } = Astro.props;
---

<div>
  <h2 class="leyenda text-rust">
    Qué lleva
  </h2>
  <ul class="mt-3.5 list-disc space-y-2 pl-5 marker:text-rust">
    {
      componentes.map((componente) => (
        <li class="leading-snug">
          <span class="font-medium">{componente.etiqueta}</span>
          <span class="text-sm text-black/65">
            {" — "}
            {componente.descripcionCorta}
          </span>
        </li>
      ))
    }
  </ul>
</div>
