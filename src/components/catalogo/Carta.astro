---
// La vista catálogo: la rejilla con todas las tartas de la carta.
//
// Tuvo una fila de filtros por familia ("De la carta" / "Personalizadas"). Se
// quitó cuando las personalizadas pasaron a tener página propia
// (/personalizadas, ver ESPECIALES en site.ts): con una sola familia, un
// filtro no filtra nada. Si algún día la carta vuelve a partirse, está en el
// historial de git.
import type { Tarta } from "@/config/site";
import { fotoDe } from "@/lib/fotos";
import TarjetaTarta from "./TarjetaTarta.astro";

interface Props {
  tartas: Tarta[];
  /**
   * Tras cuántas tarjetas se mete la banda del slot `intermedio`. Sin él (o
   * sin slot) la rejilla va de corrido.
   */
  tras?: number;
  /**
   * Nivel del encabezado de cada tarjeta. Depende de la cabecera que tenga
   * encima la página que monta la rejilla (ver TarjetaTarta).
   */
  nivelTarjeta?: 2 | 3;
  class?: string;
}

const { tartas, tras, nivelTarjeta = 3, class: className } = Astro.props;

// La banda es una CELDA de la rejilla, a todo lo ancho, y no un hermano entre
// dos rejillas: así las tarjetas de antes y de después siguen en la misma
// retícula y alineadas columna a columna.
const conBanda = tras !== undefined && Astro.slots.has("intermedio");
// Se resuelven aquí y no en la tarjeta: `import.meta.glob` es relativo al
// archivo que lo escribe, así que repetido por componente cada uno lleva su
// propia ruta y basta mover una carpeta para romper una en silencio.
//
// El tono del marco de "foto pendiente" alterna según la posición, para que
// los huecos no se lean como seis errores idénticos en fila.
const conFoto = tartas.map((tarta, i) => ({
  tarta,
  foto: fotoDe(tarta.archivo),
  recorte: tarta.recorte ? fotoDe(tarta.recorte) : null,
  numero: i + 1,
  tono: i % 2 === 0 ? "" : "[&>div:first-child]:bg-sand/55",
}));

const antes = conBanda ? conFoto.slice(0, tras) : conFoto;
const despues = conBanda ? conFoto.slice(tras) : [];

---

<div class={className}>
  {
    /* El filete de arriba es el que antes colgaba de los filtros: separa la
      cabecera de la página de la rejilla. */
  }
  <div class="border-t border-taupe/55"></div>

  {
    /* Es un <div> y no un <ul> porque la banda va dentro de la rejilla, y una
      nota de encargo no es un elemento más de la lista de tartas: en un <li>
      un lector de pantalla anunciaría "lista de 9 elementos" con una que no
      es tarta. Cada tarjeta ya es un encabezado con su enlace. */
  }
  <div
    data-rejilla
    class="mt-11 grid grid-cols-2 gap-x-4 gap-y-11 sm:gap-x-6 md:mt-13 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-7"
  >
    {
      antes.map((entrada) => (
        <TarjetaTarta
          tarta={entrada.tarta}
          foto={entrada.foto}
          recorte={entrada.recorte}
          numero={entrada.numero}
          nivel={nivelTarjeta}
          class={entrada.foto || entrada.recorte ? undefined : entrada.tono}
        />
      ))
    }

    {
      conBanda && (
        <div class="col-span-full my-4 lg:my-6">
          <slot name="intermedio" />
        </div>
      )
    }

    {
      despues.map((entrada) => (
        <TarjetaTarta
          tarta={entrada.tarta}
          foto={entrada.foto}
          recorte={entrada.recorte}
          numero={entrada.numero}
          nivel={nivelTarjeta}
          class={entrada.foto || entrada.recorte ? undefined : entrada.tono}
        />
      ))
    }
  </div>

</div>
