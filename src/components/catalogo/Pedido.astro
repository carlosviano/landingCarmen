---
// El pedido de la ficha: tamaño, cantidad, fecha, total y el único CTA de la
// página, que abre WhatsApp con todo eso ya escrito.
//
// No se envía nada desde aquí: no hay servidor, la web es estática. El
// formulario sólo sirve para escribir el mensaje, y quien lo manda es el
// cliente desde WhatsApp. Por eso la cantidad no tiene máximo: es
// orientativa, y la confirma Carmen hablando con él.
//
// Funciona sin JS, a medias y a propósito: el CTA es un <a> normal cuyo `href`
// sale del build con el mensaje de siempre ("quería pedir la tarta X"), así
// que el botón abre WhatsApp igual. Lo que hace el script es rehacer ese
// `href` y el total cada vez que cambia el formulario, y parar el pedido si
// la fecha no vale.
//
// La fecha va en el calendario compartido (formulario/Calendario.astro), con
// los días que no son laborables o no llegan a la antelación apagados.
//
// Los controles visten las clases de formulario/estilos.ts, las mismas que la
// solicitud de eventos: los dos formularios tienen que parecer uno.
import { Icon } from "astro-icon/components";
import Calendario from "@/components/formulario/Calendario.astro";
import {
  BOTON,
  BOTON_ICONO,
  ETIQUETA,
  OPCION_OCULTA,
  PASTILLA,
} from "@/components/formulario/estilos";
import { PEDIDO, type Tarta } from "@/config/site";
import { mensajePedido, precioVisible } from "@/lib/pedido";

interface Props {
  tarta: Tarta;
}

const { tarta } = Astro.props;
const [primero] = tarta.tamanos;

// Con un solo tamaño no hay nada que elegir, así que no se pinta el selector.
// El script lee entonces el tamaño de los `data-` del propio <form>.
const conSelector = tarta.tamanos.length > 1;
---

<form
  data-pedido
  data-nombre={tarta.nombre}
  data-personas={primero.personas}
  data-precio={primero.precio}
  novalidate
  class="flex flex-col gap-4 bajo:gap-3"
>
  {
    /* Radios de verdad dentro de un <fieldset> con su <legend>: el lector de
      pantalla anuncia "Tamaño, grupo" y las flechas pasan de uno a otro. El
      radio va encima de su pastilla, transparente, así que el clic y el foco
      son suyos; el aspecto lo pone la pastilla (`peer-checked:`). */
    conSelector && (
      <fieldset class="min-w-0">
        <legend class={`mb-2.5 bajo:mb-2 ${ETIQUETA}`}>
          Tamaño
        </legend>
        <div
          class="grid gap-2"
          style={`grid-template-columns: repeat(${tarta.tamanos.length}, minmax(0, 1fr))`}
        >
          {tarta.tamanos.map((tamano, i) => (
            <label class="relative cursor-pointer">
              <input
                type="radio"
                name="tamano"
                value={tamano.personas}
                data-personas={tamano.personas}
                data-precio={tamano.precio}
                checked={i === 0}
                class={OPCION_OCULTA}
              />
              <span class={`${PASTILLA} flex flex-col items-center px-1 py-2 bajo:py-1.5 peer-checked:[&>b]:text-linen`}>
                <b class="titulo text-[1.2rem] leading-tight bajo:text-[1.05rem] text-black">
                  {tamano.personas}
                </b>
                personas
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  {
    /* `relative`: el calendario se abre debajo de esta fila y con su ancho
      entero, no con el de la columna de la fecha, que en móvil es estrecha. */
  }
  <div class="relative grid grid-cols-[auto_minmax(0,1fr)] gap-3.5">
    <div class="flex flex-col gap-2">
      <label for="pedido-cantidad" class={ETIQUETA}>
        Cantidad
      </label>
      <div class="flex h-11 items-center bajo:h-10 rounded-full border border-black/40">
        <button
          type="button"
          data-paso="-1"
          aria-label="Quitar una"
          class={`${BOTON_ICONO} h-full w-10`}
        >
          <Icon name="lucide:minus" class="size-4" aria-hidden="true" />
        </button>
        <input
          id="pedido-cantidad"
          data-cantidad
          type="number"
          min="1"
          value="1"
          inputmode="numeric"
          class="w-9 bg-transparent text-center font-medium [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
        <button
          type="button"
          data-paso="1"
          aria-label="Añadir una"
          class={`${BOTON_ICONO} h-full w-10`}
        >
          <Icon name="lucide:plus" class="size-4" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-2">
      <span id="pedido-fecha-etiqueta" class={ETIQUETA}>
        Fecha de entrega
      </span>
      <Calendario
        id="pedido-fecha"
        nombre="fecha"
        etiquetaId="pedido-fecha-etiqueta"
        descripcionId="pedido-fecha-nota"
        titulo="Elegir fecha de entrega"
      />
    </div>
  </div>

  <p id="pedido-fecha-nota" class="-mt-1.5 text-xs text-black/60">
    De lunes a viernes, con {PEDIDO.antelacion} de antelación.
  </p>

  <dl class="border-y border-taupe/45">
    <div class="flex items-baseline justify-between gap-6 py-2.5">
      <dt class="dato text-[10px] text-black/60">
        Conservación
      </dt>
      <dd class="text-right text-sm text-black/80">{tarta.conservacion}</dd>
    </div>
  </dl>

  {
    /* El precio va AQUÍ, al lado del botón, y no arriba con el nombre: depende
      del tamaño y de la cantidad, así que es un total, y un total se lee
      donde se decide. `aria-live` para que se anuncie al cambiar. */
  }
  <div class="mt-1 flex items-center justify-between gap-4 bajo:mt-0">
    <p class="flex flex-col leading-none">
      <span class="dato text-[10px] text-black/60">Total</span>
      <span
        data-total
        aria-live="polite"
        class="mt-1.5 text-2xl font-medium whitespace-nowrap text-rust tabular-nums lg:text-[1.65rem] bajo:text-2xl"
      >
        {precioVisible(primero.precio)}
      </span>
    </p>

    {
      /* El texto sale de `PEDIDO.etiqueta` y nombra WhatsApp a propósito: un
        botón que te saca de la página tiene que decir a dónde te lleva. */
    }
    <a
      data-cta
      href={PEDIDO.enlace(mensajePedido(tarta.nombre))}
      target="_blank"
      rel="noopener noreferrer"
      class={`${BOTON} flex-1 sm:flex-none`}
    >
      <Icon name="simple-icons:whatsapp" class="size-4 shrink-0" aria-hidden="true" />
      {PEDIDO.etiqueta}
    </a>
  </div>

  <p data-error role="alert" hidden class="text-sm font-medium text-rust"></p>

  {
    /* Qué pasa al pulsar, como texto visible y no en un `aria-label`: la duda
      de "¿se envía ya?" la tiene todo el mundo. */
  }
  <p class="max-w-[42ch] text-xs leading-relaxed text-black/60">
    Se abre WhatsApp con el pedido ya escrito: tamaño, cantidad y fecha. No se
    envía nada hasta que lo envíes tú.
  </p>
</form>

<script>
  import { PEDIDO } from "@/config/site";
  import { montarCalendario } from "@/lib/calendario";
  import {
    aISO,
    esLaborable,
    fechaMinima,
    mensajePedido,
    precioVisible,
    problemaFecha,
  } from "@/lib/pedido";

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-pedido]")) {
    const nombre = form.dataset.nombre ?? "";
    const cantidad = form.querySelector<HTMLInputElement>("[data-cantidad]");
    const fecha = form.querySelector<HTMLInputElement>("[data-calendario-valor]");
    const botonFecha = form.querySelector<HTMLButtonElement>("[data-calendario-boton]");
    const total = form.querySelector<HTMLElement>("[data-total]");
    const cta = form.querySelector<HTMLAnchorElement>("[data-cta]");
    const error = form.querySelector<HTMLElement>("[data-error]");
    if (
      !cantidad || !fecha || !botonFecha || !total || !cta || !error
    ) continue;

    // El tamaño marcado; sin selector (un solo tamaño), el del propio <form>.
    const tamano = () =>
      form.querySelector<HTMLInputElement>('input[name="tamano"]:checked') ?? form;
    const unidades = () => Math.max(1, Math.round(Number(cantidad.value) || 1));

    const avisar = (problema: string | null) => {
      error.hidden = problema === null;
      error.textContent = problema ?? "";
      if (problema) botonFecha.setAttribute("aria-invalid", "true");
      else botonFecha.removeAttribute("aria-invalid");
    };

    const actualizar = () => {
      const { personas, precio } = tamano().dataset;
      total.textContent = precioVisible(Number(precio) * unidades());
      cta.href = PEDIDO.enlace(
        mensajePedido(nombre, {
          personas,
          cantidad: unidades(),
          fecha: fecha.value || undefined,
        }),
      );
    };

    for (const boton of form.querySelectorAll<HTMLButtonElement>("[data-paso]")) {
      boton.addEventListener("click", () => {
        cantidad.value = String(Math.max(1, unidades() + Number(boton.dataset.paso)));
        actualizar();
      });
    }

    // Al salir del campo se deja en un entero de 1 para arriba: mientras se
    // escribe no, que borrar para teclear otro número pasa por el vacío.
    cantidad.addEventListener("change", () => {
      cantidad.value = String(unidades());
    });

    const calendario = montarCalendario(form, {
      primera: () => aISO(fechaMinima()),
      elegible: esLaborable,
      alElegir: () => avisar(null),
    });

    form.addEventListener("input", actualizar);
    form.addEventListener("change", actualizar);

    // Sin fecha válida no se abre WhatsApp: se explica por qué y se abre el
    // calendario para elegir otra.
    cta.addEventListener("click", (evento) => {
      const problema = problemaFecha(fecha.value);
      if (problema) {
        evento.preventDefault();
        // Que este clic no llegue al "clic fuera" que cierra el calendario.
        evento.stopPropagation();
        avisar(problema);
        calendario.abrir();
      }
    });

    // Intro en un campo enviaría el formulario, y no hay adónde enviarlo.
    form.addEventListener("submit", (evento) => evento.preventDefault());

    actualizar();
  }
</script>
