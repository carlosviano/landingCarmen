---
// El aviso de que la pantalla nueva no ha llegado.
//
// Con el <ClientRouter /> cambiar de pantalla es un fetch de la página nueva.
// Si ese fetch falla (sin cobertura, un túnel), el router de Astro se rinde y
// hace una navegación normal a la misma URL, que sin red acaba en la página
// de error del navegador: quien estaba eligiendo tarta se queda fuera de la
// web. Este aviso se mete antes: deja la pantalla en la que estaba y ofrece
// reintentar.
//
// Sólo cuando el fallo es de red. El router también se rinde, y está bien que
// lo haga, con lo que no es una página del sitio (el PDF de la carta) o con
// una redirección a otro dominio: ahí la navegación normal es lo correcto.
// Para distinguirlo, cuando se rinde se pregunta otra vez con un HEAD: si
// eso responde, el destino existe y se le deja ir; si falla, es la red.
//
// Sin JS no hay router ni aviso: cada enlace es una navegación normal.
import { Icon } from "astro-icon/components";
import { AVISO_CARGA as A } from "@/config/errores";
---

<div
  id="aviso-carga"
  role="alert"
  hidden
  class="fixed inset-x-3 bottom-[calc(1.75rem_+_env(safe-area-inset-bottom))] z-60 flex flex-col gap-4 rounded-md bg-linen p-5 text-black shadow-2xl shadow-black/40 md:inset-x-auto md:right-10 md:bottom-10 md:w-110 md:gap-4.5 md:p-6"
>
  <div class="flex items-start gap-3.5 md:gap-4">
    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-rust text-sand md:size-11">
      <Icon
        name="lucide:wifi-off"
        class="size-4.5 md:size-5"
        aria-hidden="true"
      />
    </span>
    <div class="flex flex-1 flex-col gap-1 pt-px md:gap-1.5 md:pt-0.5">
      <p
        data-aviso-titulo
        class="titulo text-[1.3rem] leading-tight md:text-2xl"
      ></p>
      <p class="text-sm leading-normal text-black/70 md:text-[15px]">
        {A.texto}
      </p>
    </div>
    <button
      type="button"
      data-aviso-cerrar
      aria-label={A.cerrar}
      class="-mt-3 -mr-3 grid size-11 shrink-0 cursor-pointer place-items-center rounded-full transition-colors hover:bg-black/5 md:-mt-2.5 md:-mr-2.5"
    >
      <Icon name="lucide:x" class="size-4.5" aria-hidden="true" />
    </button>
  </div>
  <button
    type="button"
    data-aviso-reintentar
    class="flex h-12 cursor-pointer items-center justify-center gap-2 rounded bg-rust px-5.5 accion text-xs text-linen transition-colors hover:bg-rust-hondo md:ml-15 md:h-11 md:self-start"
  >
    <Icon name="lucide:refresh-cw" class="size-3.75" aria-hidden="true" />
    {A.reintentar}
  </button>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { AVISO_CARGA } from "@/config/errores";
  import { SERVICIOS } from "@/config/site";

  // Cómo se nombra el destino en el titular. Sólo lo que tiene nombre claro;
  // lo demás es "la página".
  const NOMBRES = new Map<string, string>([
    ["/", "la portada"],
    ...Object.values(SERVICIOS).map(
      ({ ruta, nombre }) =>
        [ruta, nombre.replace(/^La /, "la ")] as [string, string],
    ),
  ]);

  let destino: URL | null = null;

  const aviso = () => document.querySelector<HTMLElement>("#aviso-carga");

  function mostrar(url: URL) {
    const el = aviso();
    if (!el) return;
    destino = url;
    const ruta = url.pathname.replace(/\/$/, "") || "/";
    el.querySelector("[data-aviso-titulo]")!.textContent = AVISO_CARGA.titulo(
      NOMBRES.get(ruta) ?? "la página",
    );
    el.hidden = false;
    el.querySelector<HTMLElement>("[data-aviso-reintentar]")?.focus();
  }

  function esconder() {
    const el = aviso();
    if (el) el.hidden = true;
  }

  // ¿Responde el destino? Un HEAD basta: no hace falta la página, sólo saber
  // si hay red. Una respuesta de error (un 404) también es "responde".
  async function responde(url: URL, senal: AbortSignal): Promise<boolean> {
    if (!navigator.onLine) return false;
    try {
      await fetch(url, { method: "HEAD", cache: "no-store", signal: senal });
      return true;
    } catch {
      return false;
    }
  }

  // Se cuelga UNA vez, no con alCargarPagina: `document` sobrevive a los
  // cambios de pantalla, y el aviso se busca cada vez que hace falta porque
  // el <body> en el que está sí cambia.
  document.addEventListener("astro:before-preparation", (evento) => {
    const cargar = evento.loader;
    evento.loader = async () => {
      await cargar();
      // El router sólo se rinde con preventDefault(). Si no lo ha hecho, o
      // si esta navegación ya la ha sustituido otra, no hay nada que hacer.
      if (!evento.defaultPrevented || evento.signal.aborted) return;
      if ((await responde(evento.to, evento.signal)) || evento.signal.aborted)
        return;

      mostrar(evento.to);
      // Y no se suelta: al volver de aquí el router navegaría a la URL de
      // todos modos. Se queda esperando hasta que otra navegación (la de
      // "Reintentar" o cualquier otro enlace) aborte esta; con la señal
      // abortada el router lo deja estar sin navegar.
      await new Promise<void>((listo) =>
        evento.signal.addEventListener("abort", () => listo(), { once: true }),
      );
    };
  });

  document.addEventListener("astro:before-preparation", esconder);

  document.addEventListener("click", (evento) => {
    const objetivo = evento.target as Element | null;
    if (objetivo?.closest("[data-aviso-cerrar]")) esconder();
    else if (objetivo?.closest("[data-aviso-reintentar]") && destino)
      navigate(destino.href);
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape" && aviso()?.hidden === false) esconder();
  });
</script>
