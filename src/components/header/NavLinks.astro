---
// Enlaces de navegación. Se usan dos veces con la misma lista pero distinta
// disposición: en fila en la barra de escritorio y en columna en el panel
// móvil. De ahí la variante.
import { NAV } from "@/config/site";

interface Props {
  variant?: "barra" | "panel";
  class?: string;
}

const { variant = "barra", class: className } = Astro.props;

// Desde que existen /catalogo y /catalogo/<tarta>, el sitio ya no es una sola
// página: un `href="#contacto"` sólo funciona si estás EN la portada. Fuera de
// ella hay que anteponer la barra para volver primero a "/" y bajar después.
//
// Se hace condicional y no siempre con barra para no perder el scroll suave en
// la portada, que es donde más se usa el menú. Las rutas de verdad (las que no
// empiezan por #) se quedan como están.
const enPortada = Astro.url.pathname === "/";
const destino = (href: string) =>
  href.startsWith("#") && !enPortada ? `/${href}` : href;

const ESTILOS = {
  barra: {
    lista: "flex items-center gap-8",
    enlace:
      "group relative accion text-sm text-sand/80 transition-colors hover:text-white",
  },
  panel: {
    lista: "flex flex-col gap-1",
    enlace:
      "block rounded-md px-2 py-3 accion text-sm text-sand/80 transition-colors hover:bg-sand/10 hover:text-white",
  },
} as const;

const estilo = ESTILOS[variant];
---

<ul class:list={[estilo.lista, className]}>
  {
    NAV.map((item) => (
      <li>
        <a href={destino(item.href)} class={estilo.enlace}>
          {item.label}
          {/* Subrayado animado, en sand pleno: el enlace en reposo va a
              sand/80, así que la barra se lee por encima del propio texto. */}
          {variant === "barra" && (
            <span
              class="absolute -bottom-1 left-0 h-0.5 w-full origin-left scale-x-0 bg-sand transition-transform duration-200 group-hover:scale-x-100 group-focus-visible:scale-x-100"
              aria-hidden="true"
            />
          )}
        </a>
      </li>
    ))
  }
</ul>
