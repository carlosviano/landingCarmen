---
// Marca del header: solo el nombre, sin icono.
// TODO: poner el logo oficial delante del nombre cuando esté listo.
import { SITE } from "@/config/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  class:list={[
    "inline-flex items-center text-linen transition-opacity hover:opacity-80",
    className,
  ]}
>
  <span class="font-serif text-xl leading-tight italic">{SITE.nombre}</span>
</a>
