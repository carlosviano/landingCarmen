---
// Menú móvil: SOLO existe por debajo de 768px (el breakpoint md de Tailwind).
// En escritorio no se ve nada de este componente, así que si estás mirando la
// web en un portátil tienes que estrechar la ventana para que aparezca.
//
// Las tres piezas viven juntas a propósito: el botón, el panel que despliega y
// el JS que los conecta. Es la única parte del header que necesita JavaScript.
//
// El panel se posiciona absolute respecto al <header> (que es sticky, y por
// tanto sirve de referencia): así se despliega por debajo de la barra ocupando
// todo el ancho, sin ser un hijo del contenedor flex y sin desplazar la página.
import { Icon } from "astro-icon/components";
import AddressLink from "./AddressLink.astro";
import NavLinks from "./NavLinks.astro";
import SocialLinks from "./SocialLinks.astro";

const PANEL_ID = "menu-movil";
---

<button
  type="button"
  data-menu-toggle
  aria-controls={PANEL_ID}
  aria-expanded="false"
  class="flex size-10 items-center justify-center rounded-md border border-linen/25 transition-colors hover:bg-linen/10 md:hidden"
>
  <span class="sr-only" data-menu-label>Abrir menú</span>
  <Icon name="lucide:menu" class="size-5" aria-hidden="true" data-icon-open />
  <Icon name="lucide:x" class="hidden size-5" aria-hidden="true" data-icon-close />
</button>

<div
  id={PANEL_ID}
  class="absolute inset-x-0 top-full hidden border-t border-linen/15 bg-rust md:hidden"
>
  <nav aria-label="Navegación móvil" class="px-6 py-4">
    <NavLinks variant="panel" />

    <div class="mt-4 flex flex-col gap-4 border-t border-linen/15 pt-4">
      {/* En la barra la dirección se oculta por debajo de lg, así que este es
          el único sitio donde la ve quien entra desde el móvil. */}
      <AddressLink class="flex px-2" />
      <SocialLinks variant="panel" />
    </div>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("menu-movil");

  if (toggle && panel) {
    const etiqueta = toggle.querySelector("[data-menu-label]");
    const iconoAbrir = toggle.querySelector("[data-icon-open]");
    const iconoCerrar = toggle.querySelector("[data-icon-close]");

    const estaAbierto = () => !panel.classList.contains("hidden");

    const mostrar = (abierto: boolean) => {
      panel.classList.toggle("hidden", !abierto);
      iconoAbrir?.classList.toggle("hidden", abierto);
      iconoCerrar?.classList.toggle("hidden", !abierto);
      toggle.setAttribute("aria-expanded", String(abierto));
      if (etiqueta) etiqueta.textContent = abierto ? "Cerrar menú" : "Abrir menú";
    };

    toggle.addEventListener("click", () => mostrar(!estaAbierto()));

    // Al pulsar un enlace navegamos a la sección: el panel ya estorba.
    panel.addEventListener("click", (evento) => {
      if ((evento.target as HTMLElement).closest("a[href^='#']")) mostrar(false);
    });

    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && estaAbierto()) {
        mostrar(false);
        toggle.focus();
      }
    });
  }
</script>
