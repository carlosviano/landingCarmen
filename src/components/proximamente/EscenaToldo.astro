  <rect class="ln glass" x="108" y="186" width="68" height="150" rx="1"></rect>
  <line class="ln grueso" x1="168" y1="250" x2="168" y2="280"></line>
  <line class="ln thin" x1="108" y1="352" x2="176" y2="352"></line>

  <!-- escaparate, con la jardinera -->
