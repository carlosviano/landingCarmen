  <line class="ln" x1="14" y1="380" x2="586" y2="380"></line>
  <line class="ln deco thin" x1="14" y1="394" x2="586" y2="394"></line>
  <line class="ln" x1="34" y1="352" x2="34" y2="380"></line>
  <circle class="ln f-cream" cx="34" cy="350" r="4"></circle>

  <!-- fachada -->
