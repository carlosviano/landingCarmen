---
// Turnstile, el captcha de Cloudflare, dentro de un formulario de solicitud.
// Comprueba en segundo plano que quien escribe es una persona y deja un token
// en un campo oculto (`cf-turnstile-response`), que viaja con el formulario y
// verifica la Function antes de enviar el correo
// (functions/_lib/turnstile.ts).
//
// Casi nunca se ve. Nace `hidden` y sólo se enseña si Turnstile duda y
// necesita que se pulse una casilla (`before-interactive-callback`): vacío,
// en la rejilla del formulario, dejaría un hueco de más entre el aviso y el
// botón.
//
// El token es de un solo uso: `montarSolicitud` pide otro después de cada
// envío.
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<div
  hidden
  class:list={["cf-turnstile", clase]}
  data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
  data-language="es"
  data-appearance="interaction-only"
  data-size="flexible"
  data-before-interactive-callback="mostrarTurnstile"
></div>

{/* Inline: Turnstile busca el callback por nombre en `window`. */}
<script is:inline>
  window.mostrarTurnstile = () =>
    document.querySelectorAll(".cf-turnstile").forEach((widget) => {
      widget.hidden = false;
    });
</script>

{/* De Cloudflare y sin empaquetar: Turnstile sólo funciona cargado desde su URL. */}
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>
