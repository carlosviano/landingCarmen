---
// Turnstile, el captcha de Cloudflare, dentro de un formulario de solicitud.
// Comprueba en segundo plano que quien escribe es una persona y deja un token
// en un campo oculto (`cf-turnstile-response`), que viaja con el formulario y
// verifica la Function antes de enviar el correo
// (functions/_lib/turnstile.ts).
//
// Casi nunca se ve: sólo si Turnstile duda y pide que se pulse una casilla.
// Lo pinta y lo renueva src/lib/turnstile.ts.
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<div
  hidden
  data-turnstile
  data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
  class={clase}
></div>

{/* De Cloudflare y sin empaquetar: Turnstile sólo funciona cargado desde su
    URL. El router lo ejecuta una sola vez por visita. */}
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer
></script>

<script>
  import { alCargarPagina } from "@/lib/pagina";
  import { montarTurnstile } from "@/lib/turnstile";

  alCargarPagina((senal) => {
    for (const widget of document.querySelectorAll<HTMLElement>(
      "[data-turnstile]",
    ))
      montarTurnstile(widget, senal);
  });
</script>
