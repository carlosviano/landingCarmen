---
// Un lightbox: las fotos de una pieza a pantalla completa, sobre fondo oscuro,
// enteras (sin recortar) y una tras otra. Se desliza con el dedo, con las
// flechas de los lados o con ← →. En móvil no hay flechas: debajo de la foto
// van unos puntos, que dicen que hay más y cuántas. Y abajo puede llevar la acción de la pieza
// ("Pedir esta tarta"): quien mira las fotos en grande está a punto de
// decidirse.
//
// Genérico: recibe las fotos, un título y la acción. Lo usan las tarjetas de
// escaparate (/personalizadas) y la cinta "Ver más" de /eventos, y tiene que
// verse y portarse igual en los dos sitios: los cambios, aquí. Lo abre cualquier botón con
// `data-abre-lightbox="<id>"`, en la foto que diga su `data-foto` (la que se
// esté viendo). Uno por pieza, con sus fotos hechas en el build: cerrado no
// se pinta y sus imágenes, en lazy, no cargan hasta que se abre.
//
// Es un <dialog> nativo, como la bienvenida: showModal() trae el foco
// atrapado, Escape y la página de detrás inerte. El fondo es el casi negro
// cálido de la web (el del velo de la bienvenida), no negro puro.
import type { HTMLAttributes } from "astro/types";
import Foto from "@/components/Foto.astro";
import { Icon } from "astro-icon/components";

export interface FotoLightbox {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  id: string;
  titulo: string;
  fotos: FotoLightbox[];
  /** El botón de abajo. Lo que no sea `texto` va tal cual al <a>. */
  accion?: { texto: string; href: string } & Omit<
    HTMLAttributes<"a">,
    "href" | "class"
  >;
  /** Para el lector de pantalla: "Foto 2 de 3". */
  textoFoto?: string;
}

const { id, titulo, fotos, accion, textoFoto = "Foto" } = Astro.props;
const { texto: textoAccion, ...enlaceAccion } = accion ?? { texto: "" };
const varias = fotos.length > 1;

const FLECHA =
  "absolute top-1/2 z-10 hidden size-12 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-linen/30 text-linen transition-colors hover:bg-linen/10 disabled:pointer-events-none disabled:opacity-25 md:grid";
---

<dialog
  id={id}
  data-lightbox
  aria-label={`Fotos de ${titulo}`}
  class="lightbox m-0 h-dvh max-h-none w-full max-w-none bg-[rgb(28_16_10)] p-0 text-linen backdrop:bg-[rgb(28_16_10)]"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-6 pt-5 pb-3 lg:px-10 lg:pt-7">
      <p class="flex min-w-0 items-baseline gap-4">
        <span class="truncate titulo text-2xl text-linen lg:text-3xl">
          {titulo}
        </span>
        {varias && (
          <span
            data-contador
            class="shrink-0 dato text-[11px] whitespace-nowrap text-linen/60 tabular-nums"
          >
            1 / {fotos.length}
          </span>
        )}
      </p>
      <button
        type="button"
        data-cerrar
        aria-label="Cerrar"
        class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-linen/30 text-linen/80 transition-colors hover:border-linen hover:text-linen"
      >
        <Icon name="lucide:x" class="size-4.5" aria-hidden="true" />
      </button>
    </div>

    <div class="relative min-h-0 flex-1">
      <ul
        data-pista
        class="flex h-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {fotos.map((foto, i) => (
          <li
            data-diapositiva
            aria-label={
              varias ? `${textoFoto} ${i + 1} de ${fotos.length}` : undefined
            }
            class="flex h-full w-full shrink-0 snap-center items-center justify-center px-4 py-2 md:px-24"
          >
            <Foto
              src={foto.src}
              alt={foto.alt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 768px) 80vw, 100vw"
              loading="lazy"
              decoding="async"
              class="max-h-full max-w-full rounded-xl object-contain"
            />
          </li>
        ))}
      </ul>

      {varias && (
        <>
          <button
            type="button"
            data-anterior
            aria-label="Foto anterior"
            class:list={[FLECHA, "left-6 lg:left-10"]}
          >
            <Icon
              name="lucide:chevron-left"
              class="size-5"
              aria-hidden="true"
            />
          </button>
          <button
            type="button"
            data-siguiente
            aria-label="Foto siguiente"
            class:list={[FLECHA, "right-6 lg:right-10"]}
          >
            <Icon
              name="lucide:chevron-right"
              class="size-5"
              aria-hidden="true"
            />
          </button>
        </>
      )}
    </div>

    {
      /* Los puntos, sólo en móvil (en escritorio ya están las flechas): el
        de la foto que se ve, alargado. Cada uno es un botón con su hueco de
        24px aunque se vea de 6. */
      varias && (
        <div class="flex justify-center pt-2 md:hidden">
          {fotos.map((_, i) => (
            <button
              type="button"
              data-punto={i}
              aria-label={`${textoFoto} ${i + 1} de ${fotos.length}`}
              class="group/punto flex h-6 cursor-pointer items-center px-1"
            >
              <span class="block h-1.5 w-1.5 rounded-full bg-linen/35 transition-all group-aria-current/punto:w-6 group-aria-current/punto:bg-linen" />
            </button>
          ))}
        </div>
      )
    }

    {accion && (
      <div class="flex justify-center px-6 pt-3 pb-6 lg:pb-8">
        <a
          {...enlaceAccion}
          data-accion-lightbox
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-sand px-8 accion text-xs text-rust transition-colors hover:bg-white sm:w-auto"
        >
          {textoAccion}
        </a>
      </div>
    )}
  </div>
</dialog>

<style>
  /* Aparece y desaparece fundiéndose. `display` y `overlay` con
     allow-discrete para que el cierre se vea; donde no se entiende, en seco. */
  .lightbox,
  .lightbox::backdrop {
    opacity: 0;
    transition:
      opacity 0.25s ease-out,
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }
  .lightbox[open],
  .lightbox[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .lightbox[open],
    .lightbox[open]::backdrop {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox::backdrop {
      transition: none;
    }
  }
</style>

<style is:global>
  /* Como la bienvenida: que la rueda no mueva la página de detrás. */
  html:has(dialog[data-lightbox][open]) {
    overflow: hidden;
  }
</style>

<script>
  for (const caja of document.querySelectorAll<HTMLDialogElement>(
    "dialog[data-lightbox]",
  )) {
    const pista = caja.querySelector<HTMLElement>("[data-pista]")!;
    const diapositivas = [
      ...pista.querySelectorAll<HTMLElement>("[data-diapositiva]"),
    ];
    const contador = caja.querySelector<HTMLElement>("[data-contador]");
    const anterior = caja.querySelector<HTMLButtonElement>("[data-anterior]");
    const siguiente = caja.querySelector<HTMLButtonElement>("[data-siguiente]");
    const puntos = [
      ...caja.querySelectorAll<HTMLButtonElement>("[data-punto]"),
    ];

    const actual = () => Math.round(pista.scrollLeft / pista.clientWidth);

    const irA = (i: number, comportamiento: ScrollBehavior = "smooth") => {
      const destino = Math.max(0, Math.min(i, diapositivas.length - 1));
      pista.scrollTo({
        left: destino * pista.clientWidth,
        behavior: comportamiento,
      });
    };

    // Contador, flechas y puntos siguen al scroll, venga del dedo, de las
    // flechas, de los puntos o del teclado.
    const pintar = () => {
      const i = actual();
      if (contador) contador.textContent = `${i + 1} / ${diapositivas.length}`;
      if (anterior) anterior.disabled = i === 0;
      if (siguiente) siguiente.disabled = i === diapositivas.length - 1;
      puntos.forEach((punto, j) => {
        if (j === i) punto.setAttribute("aria-current", "true");
        else punto.removeAttribute("aria-current");
      });
    };
    pista.addEventListener("scroll", pintar, { passive: true });

    anterior?.addEventListener("click", () => irA(actual() - 1));
    siguiente?.addEventListener("click", () => irA(actual() + 1));
    puntos.forEach((punto, i) => punto.addEventListener("click", () => irA(i)));

    caja.addEventListener("keydown", (evento) => {
      if (evento.key === "ArrowLeft") irA(actual() - 1);
      else if (evento.key === "ArrowRight") irA(actual() + 1);
      else return;
      evento.preventDefault();
    });

    caja
      .querySelector("[data-cerrar]")
      ?.addEventListener("click", () => caja.close());

    // Pulsar el hueco alrededor de la foto (no la foto) también cierra.
    pista.addEventListener("click", (evento) => {
      if ((evento.target as HTMLElement).hasAttribute("data-diapositiva"))
        caja.close();
    });

    // La acción cierra antes de hacer lo suyo: en captura, para ir por
    // delante de lo que la página le haya colgado al enlace (bajar al
    // formulario no funciona con la página bloqueada detrás).
    caja.addEventListener(
      "click",
      (evento) => {
        if ((evento.target as HTMLElement).closest("[data-accion-lightbox]"))
          caja.close();
      },
      { capture: true },
    );

    // Los botones que lo abren, en la foto que digan.
    for (const boton of document.querySelectorAll<HTMLElement>(
      `[data-abre-lightbox="${CSS.escape(caja.id)}"]`,
    )) {
      boton.addEventListener("click", () => {
        caja.showModal();
        irA(Number(boton.dataset.foto ?? 0), "instant");
        pintar();
      });
    }
  }
</script>
