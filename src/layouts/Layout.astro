---
import { Font } from "astro:assets";
import Bienvenida from "@/components/Bienvenida.astro";
import { SITE } from "@/config/site";
import "../styles/global.css";

interface Props {
  /**
   * Se antepone al nombre del sitio en el <title>. Sin él queda solo el
   * nombre, que es lo que quiere la portada.
   */
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = SITE.nombre } = Astro.props;
const title = titulo ? `${titulo} · ${SITE.nombre}` : SITE.nombre;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={descripcion} />
    <meta name="author" content="Carlos Viano" />
    <Font cssVariable="--font-prata" preload />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="min-h-full w-full bg-linen text-black">
    <slot />
    <Bienvenida />
  </body>
</html>
